{
  "version": "1",
  "selectors": [
    "[data-sensitive='true']",
    ".ssn",
    ".credit-card",
    ".blur",
    ".hide"
  ],
  "regex": [
    {
      "name": "Email",
      "pattern": "[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}",
      "flags": "gi",
      "preset": "email"
    },
    {
      "name": "IPv4",
      "pattern": "\\b(?:(?:25[0-5]|2[0-4]\\d|1?\\d{1,2})\\.){3}(?:25[0-5]|2[0-4]\\d|1?\\d{1,2})\\b",
      "flags": "gi",
      "preset": "ipv4"
    },
    {
      "name": "IPv6",
      "pattern": "(?<![A-Fa-f0-9]|[A-Fa-f0-9]:|::)(?:(?:[A-Fa-f0-9]{1,4}:){7}[A-Fa-f0-9]{1,4}|(?:[A-Fa-f0-9]{1,4}:){6}(?:25[0-5]|2[0-4]\\d|1?\\d{1,2})(?:\\.(?:25[0-5]|2[0-4]\\d|1?\\d{1,2})){3}|[A-Fa-f0-9]{1,4}:(?::[A-Fa-f0-9]{1,4}){1,6}|(?:[A-Fa-f0-9]{1,4}:){1,2}(?::[A-Fa-f0-9]{1,4}){1,5}|(?:[A-Fa-f0-9]{1,4}:){1,3}(?::[A-Fa-f0-9]{1,4}){1,4}|(?:[A-Fa-f0-9]{1,4}:){1,4}(?::[A-Fa-f0-9]{1,4}){1,3}|(?:[A-Fa-f0-9]{1,4}:){1,5}(?::[A-Fa-f0-9]{1,4}){1,2}|(?:[A-Fa-f0-9]{1,4}:){1,6}:[A-Fa-f0-9]{1,4}|(?:[A-Fa-f0-9]{1,4}:){1,7}:|:(?:(?::[A-Fa-f0-9]{1,4}){1,7}|:))(?![A-Fa-f0-9]|:[A-Fa-f0-9:])",
      "flags": "gi",
      "preset": "ipv6"
    }
  ],
  "ignore": {
    "selectors": [
      ".public-data",
      "#marketing-section *"
    ],
    "regex": [
      {
        "pattern": "support@mycompany\\.com",
        "flags": "i"
      },
      {
        "pattern": "demo[0-9]+@example\\.com",
        "flags": "i"
      }
    ]
  }
}
